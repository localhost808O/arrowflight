{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrowflight.local/schemas/benchmark-result-v1.schema.json",
  "title": "ArrowFlight benchmark result artifacts",
  "description": "Version 1 contract for run, engine, paired comparison, and aggregate artifacts.",
  "oneOf": [
    {
      "$ref": "#/$defs/runArtifact"
    },
    {
      "$ref": "#/$defs/engineArtifact"
    },
    {
      "$ref": "#/$defs/pairedArtifact"
    },
    {
      "$ref": "#/$defs/aggregateArtifact"
    }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_type": {
          "enum": [
            "run",
            "engine-result",
            "paired-comparison",
            "aggregate-summary"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "benchmark",
        "mode",
        "started_at",
        "finished_at",
        "source",
        "workload",
        "policy",
        "runtime_dependencies",
        "topology",
        "status",
        "failure_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "required": [
            "git_sha",
            "dirty",
            "dirty_files"
          ],
          "properties": {
            "git_sha": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            },
            "dirty_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "workload": {
          "type": "object",
          "required": [
            "query_set",
            "scale_factor"
          ]
        },
        "policy": {
          "type": "object",
          "required": [
            "warmup_seconds",
            "measurement_seconds",
            "cache_policy",
            "repetitions",
            "paired_observations",
            "minimum_publishable_pairs",
            "terminals",
            "rate",
            "starting_engine_order",
            "engine_order_schedule"
          ]
        },
        "runtime_dependencies": {
          "type": "object"
        },
        "topology": {
          "type": "object"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "executionPaths": {
      "type": "object",
      "required": [
        "classification",
        "uniform_path",
        "pushdown_evidence",
        "reason",
        "nodes",
        "events"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/executionPath"
        },
        "uniform_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/executionPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "pushdown_evidence": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node",
              "paths"
            ]
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "execution_path",
              "pushdown_evidence",
              "success",
              "node"
            ]
          }
        }
      }
    },
    "executionPath": {
      "enum": [
        "footer-count",
        "footer-stats",
        "duckdb-scan",
        "duckdb-aggregation",
        "duckdb-join",
        "distributed",
        "mixed",
        "fallback",
        "unknown"
      ]
    },
    "engine": {
      "type": "object",
      "required": [
        "id",
        "order_index",
        "status",
        "failure_reason",
        "summary",
        "raw_measurements",
        "artifact_refs",
        "correctness",
        "physical_plan_refs",
        "execution_paths",
        "validity",
        "publication"
      ],
      "properties": {
        "id": {
          "enum": [
            "flight",
            "direct"
          ]
        },
        "order_index": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "object"
        },
        "raw_measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "logical_query_id",
              "observation_index",
              "repetition_index",
              "start_time_microseconds",
              "latency_microseconds",
              "worker_id",
              "phase_id"
            ]
          }
        },
        "artifact_refs": {
          "type": "object"
        },
        "correctness": {
          "type": "object",
          "required": [
            "status",
            "queries"
          ]
        },
        "physical_plan_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_paths": {
          "$ref": "#/$defs/executionPaths"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_index",
        "engine_order",
        "cache_policy",
        "warmup_seconds",
        "repetitions",
        "started_at",
        "finished_at",
        "status",
        "failures",
        "engines",
        "metrics",
        "validity"
      ],
      "properties": {
        "observation_index": {
          "type": "integer",
          "minimum": 1
        },
        "engine_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "flight",
              "direct"
            ]
          }
        },
        "cache_policy": {
          "type": "string",
          "minLength": 1
        },
        "warmup_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "completed",
            "partial-failure",
            "failed"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "engine",
              "exit_code",
              "reason"
            ]
          }
        },
        "engines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/engine"
          }
        },
        "metrics": {
          "type": "object"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "valid",
        "reasons"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "state",
        "reasons"
      ],
      "properties": {
        "state": {
          "enum": [
            "publishable",
            "not-publishable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "pushdown_evidence": {
          "type": "boolean"
        }
      }
    },
    "runArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "type": "object",
          "required": [
            "run"
          ],
          "properties": {
            "artifact_type": {
              "const": "run"
            },
            "run": {
              "$ref": "#/$defs/run"
            }
          }
        }
      ]
    },
    "engineArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "type": "object",
          "required": [
            "run_id",
            "observation_index",
            "engine"
          ],
          "properties": {
            "artifact_type": {
              "const": "engine-result"
            },
            "run_id": {
              "type": "string"
            },
            "observation_index": {
              "type": "integer",
              "minimum": 1
            },
            "engine": {
              "$ref": "#/$defs/engine"
            }
          }
        }
      ]
    },
    "aggregateArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "type": "object",
          "required": [
            "run_id",
            "summary",
            "raw_repetition_refs"
          ],
          "properties": {
            "artifact_type": {
              "const": "aggregate-summary"
            },
            "run_id": {
              "type": "string"
            },
            "summary": {
              "type": "object",
              "required": [
                "engines",
                "paired"
              ]
            },
            "raw_repetition_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "pairedArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "type": "object",
          "required": [
            "run",
            "dataset",
            "queries",
            "observations",
            "comparison",
            "aggregate_summary",
            "validation"
          ],
          "properties": {
            "artifact_type": {
              "const": "paired-comparison"
            },
            "run": {
              "$ref": "#/$defs/run"
            },
            "dataset": {
              "type": "object",
              "required": [
                "manifest_ref",
                "manifest_sha256",
                "manifest"
              ]
            },
            "queries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "logical_query_id",
                  "name",
                  "digest",
                  "sql_ref",
                  "physical_plan_refs",
                  "execution_path_refs"
                ]
              }
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/observation"
              }
            },
            "comparison": {
              "type": "object",
              "required": [
                "engine_order_schedule",
                "correctness",
                "validity",
                "publication"
              ]
            },
            "aggregate_summary": {
              "type": "object",
              "required": [
                "engines",
                "paired"
              ]
            },
            "validation": {
              "type": "object",
              "required": [
                "valid",
                "schema"
              ]
            }
          }
        }
      ]
    }
  }
}
